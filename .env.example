# ScholarOS environment. Copy to .env.local. Every value is optional for local dev.

# --- App ---
APP_URL=http://localhost:3000
# Used to sign session cookies in local auth mode. Generate: openssl rand -hex 32
SESSION_SECRET=

# --- Provider selection (defaults shown) ---
DB_PROVIDER=local            # local | supabase
AUTH_PROVIDER=local          # local (Supabase Auth adapter: see ROADMAP.md)
STORAGE_PROVIDER=local       # local | supabase
AI_PROVIDER=mock             # mock | anthropic
BILLING_PROVIDER=dev         # dev | paddle
ALLOW_DEV_BILLING=false      # true lets dev billing work under NODE_ENV=production (local testing ONLY; never on a real deployment)
EMAIL_PROVIDER=console       # console | resend (resend: not implemented yet)

# --- Supabase (only when *_PROVIDER=supabase) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=    # server-only, never expose to the browser
SUPABASE_STORAGE_BUCKET=manuscripts

# --- Anthropic (only when AI_PROVIDER=anthropic) ---
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
AI_MAX_OUTPUT_TOKENS=2500
AI_MAX_INPUT_CHARS=24000      # per-request manuscript excerpt cap
AI_MAX_RETRIES=2
AI_MONTHLY_TOKEN_BUDGET_FREE=60000

# --- Paddle (only when BILLING_PROVIDER=paddle) ---
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_SINGLE=
PADDLE_PRICE_PRO=
PADDLE_PRICE_LAB=
