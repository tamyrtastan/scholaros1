# ScholarOS environment. Copy to .env.local (local) or set in Vercel (production). No secret is committed.

# --- App ---
APP_URL=http://localhost:3000            # public origin; must equal the Supabase "Site URL"

# --- Supabase Auth (email/password, email verification, password reset) ---
SUPABASE_URL=http://127.0.0.1:54321      # https://<ref>.supabase.co in production
SUPABASE_ANON_KEY=                       # "anon public" key (Project Settings -> API). Server-side only in this app.

# --- Database (Supabase Postgres, or any Postgres with supabase/migrations applied) ---
DB_PROVIDER=postgres
# Local Supabase CLI default shown. Production: the pooled (port 6543) or direct connection string from
# Project Settings -> Database. Use a server-side secret; it bypasses RLS (service code enforces ownership).
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_SSL=                            # disable | require (default for non-local hosts) | no-verify | verify (+ DATABASE_SSL_CA)
DATABASE_SSL_CA=                         # PEM, only for DATABASE_SSL=verify
DATABASE_POOL_MAX=5

# --- File storage: PRIVATE bucket over the S3 protocol (Supabase Storage S3 endpoint works) ---
STORAGE_PROVIDER=local                   # local (dev only; refused in production) | s3
S3_ENDPOINT=                             # Supabase: https://<ref>.storage.supabase.co/storage/v1/s3
S3_REGION=us-east-1                      # Supabase: the project's region
S3_BUCKET=manuscripts
S3_ACCESS_KEY_ID=                        # Supabase: Project Settings -> Storage -> S3 Connection -> new access key
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# --- AI ---
AI_PROVIDER=mock                         # mock (offline, free) | anthropic. Demo projects ALWAYS use mock (zero tokens).
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
AI_EFFORT=medium                         # claude-sonnet-5-5 only: low | medium | high
AI_REFUSAL_FALLBACK=true                 # server-side refusal fallback (Claude API only); set false elsewhere
AI_MAX_OUTPUT_TOKENS=2500
AI_MAX_INPUT_CHARS=24000                 # per-comment manuscript excerpt cap
AI_MAX_RETRIES=2                         # bounded retries (validation + transient errors)
# ANTHROPIC_BASE_URL=                    # tests only (points the real SDK at a local fake)

AUTH_RATE_LIMIT_PER_MINUTE=10            # per-IP sign-up/sign-in/reset attempts; raise only in test environments

# --- Billing ---
BILLING_PROVIDER=dev                     # dev | paddle
ALLOW_DEV_BILLING=false                  # true lets dev billing run under NODE_ENV=production (local testing ONLY)
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_SINGLE=
PADDLE_PRICE_PRO=
PADDLE_PRICE_LAB=

# --- Email (transactional mail for auth is sent by Supabase; this is for future app mail) ---
EMAIL_PROVIDER=console
